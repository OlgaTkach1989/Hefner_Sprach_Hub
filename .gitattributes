* text=auto

# Keep repository text files stable across Windows/Linux environments.
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.example text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Binary archives and media must never be line-ending converted.
*.bundle binary
*.gz binary
*.jpg binary
*.mp4 binary
*.png binary
*.tar binary
*.zip binary
